1 ICON "PadClip.ico"
101 RCDATA "updater.ps1"
102 RCDATA "release.txt"

1 24 "PadClip.manifest"

#include <windows.h>
#include "keyboard.h"
KEYBOARD_DIALOG DIALOGEX 0, 0, 360, 235
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard shortcut"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Select keys to hold together. Use Next step to add a sequence.", -1, 7, 6, 347, 12
    COMBOBOX KEY_PAGE, 7, 22, 147, 85, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Other key", -1, 160, 24, 40, 12
    COMBOBOX KEY_OTHER, 202, 22, 108, 110, CBS_SORT | CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON "Toggle", KEY_ADD, 314, 21, 39, 15
    LTEXT "", KEY_STEP, 7, 139, 64, 12
    PUSHBUTTON "Previous", KEY_PREVIOUS, 75, 137, 55, 15
    PUSHBUTTON "Next step", KEY_NEXT, 134, 137, 58, 15
    PUSHBUTTON "Remove step", KEY_REMOVE, 196, 137, 73, 15
    PUSHBUTTON "Clear all", KEY_CLEAR, 273, 137, 80, 15
    EDITTEXT KEY_PREVIEW, 7, 157, 346, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "Save", IDOK, 244, 213, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 301, 213, 52, 15
END
